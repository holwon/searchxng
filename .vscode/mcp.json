{
  // VS Code MCP 配置：通过 npx 启动 mcp-searxng（stdio 模式）
  // 前置条件：Docker 中的 SearXNG 已启动
  //   cd searxng-mcp && docker compose up -d
  "servers": {
    "searxng-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://127.0.0.1:8000"
      }
    }
  }
}
